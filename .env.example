# Copy to .env and fill in. .env is git-ignored - never commit real values.
# With the defaults below the pipeline runs fully offline on synthetic data.

# --- Run mode ---------------------------------------------------------------
PIPELINE_MODE=synthetic          # synthetic | live
WAREHOUSE=duckdb                 # duckdb (local) | bigquery
LOG_LEVEL=INFO
LOG_FORMAT=text                  # text | json

# --- Local warehouse (WAREHOUSE=duckdb) ---------------------------------------
DUCKDB_PATH=artifacts/warehouse.duckdb

# --- BigQuery (WAREHOUSE=bigquery) --------------------------------------------
# Auth uses Application Default Credentials: `gcloud auth application-default login`
# locally, or an attached service account / Workload Identity in CI.
# No key file path is read by this project.
GCP_PROJECT_ID=
BQ_LOCATION=EU
BQ_DATASET_RAW=marketing_raw
BQ_DATASET_STAGING=marketing_staging
BQ_DATASET_REPORTING=marketing_reporting

# --- Secrets backend (PIPELINE_MODE=live) -------------------------------------
# env: read the values below from the environment
# gcp_secret_manager: read each secret from Secret Manager in GCP_PROJECT_ID,
#   using the lower-cased, hyphenated variable name (META_ACCESS_TOKEN -> meta-access-token)
SECRET_BACKEND=env

# --- GA4 Data API -------------------------------------------------------------
GA4_PROPERTY_ID=

# --- Google Ads API -----------------------------------------------------------
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# --- Meta Marketing API -------------------------------------------------------
META_AD_ACCOUNT_ID=              # numeric id, without the act_ prefix
META_API_VERSION=                # e.g. v24.0 - set to a currently supported version
META_ACCESS_TOKEN=
